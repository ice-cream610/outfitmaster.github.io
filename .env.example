# Copy to .env locally; never commit credentials.
# Active AI studio chat (Qwen3.8-Flash). Both values are server-only.
DASHSCOPE_API_KEY=
# Paste the OpenAI-compatible base URL for the SAME region/workspace as the key.
# Example: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Do not append /chat/completions. No VITE_ prefix on any secret.
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-flash

# Legacy #agent-lab configuration, independent of the active studio.
# Leave key blank for explicitly labelled offline mode.
MODEL_API_KEY=
# Use the base URL from your provider console; do not include /chat/completions.
# DeepSeek example: https://api.deepseek.com
# Qwen: use your region/workspace's OpenAI-compatible base URL.
MODEL_BASE_URL=
MODEL_NAME=qwen-plus
PORT=8787

# Optional reference-based E image generation, independent of the text model.
# Gemini Interactions API. Keep original E + selected product photos as inputs.
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
