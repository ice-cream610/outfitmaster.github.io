    "data:seed": "python scripts/seed-catalog.py",
    "data:import": "python scripts/import-public-data.py"
  },
  "dependencies": {
    "lucide-react": "0.454.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "esbuild": "0.25.12"
  }
}
