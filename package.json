{
  "name": "outfit-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 5176",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
